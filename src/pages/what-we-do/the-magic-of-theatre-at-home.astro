---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import OtherWork from "../../components/OtherWork.astro";
---

<BaseLayout
    title="Box Office VR – The Magic of Theatre at home | 42 Interactive"
    bodyClass="bovr-page"
    additionalStyles={["/css/bovr.css"]}
>
    <Header activePage="home" />

    <main class="main-content">
        <!-- ========================================
             HERO
             ======================================== -->
        <section class="bovr-hero section-hero fade-in" data-theme="dark">
            <div class="hero-bg-image-wrapper">
                <img
                    src="/images/work/bovr/image-bovr-hero.png"
                    alt="Box Office VR Hero"
                    class="hero-bg-image"
                />
            </div>
            <div class="hero-info">
                <div class="hero-text-box">
                    <h1 class="hero-title">The Magic of Theatre at home</h1>
                </div>
            </div>
        </section>

        <!-- ========================================
             INTRO – WHAT WE'VE DONE
             ======================================== -->
        <section class="section-intro fade-in" data-theme="dark">
            <p class="intro-label">WHAT WE'VE DONE</p>
            <p class="intro-text">
                We <span class="bold">designed</span> and <span class="bold"
                    >developed</span
                > an <span class="bold"
                    >immersive VR theatre streaming platform</span
                >.<br />
                The platform <span class="bold">delivers</span> live and on-demand
                performances in virtual environments.<br />
                It <span class="bold">extends</span> theatre experiences beyond the
                stage and into the home.
            </p>
        </section>

        <!-- ========================================
             IMMERSIVE SECTION
             ======================================== -->
        <section class="bovr-immersive" data-theme="dark">
            <div class="section-inner bovr-immersive__inner">
                <div class="bovr-immersive__logo">
                    <img
                        src="/images/work/bovr/logo-bovr.svg"
                        alt="Box Office VR Logo"
                    />
                </div>
                <div class="bovr-immersive__content">
                    <h2 class="bovr-immersive__title">
                        So immersive you want to reach out to touch the
                        performers, anywhere anytime.
                    </h2>
                    <div class="bovr-immersive__columns">
                        <p>
                            <span class="bold">Box Office VR</span> is a joint venture
                            between 42 Interactive and Neon 8, a Scotland-based filmmaker
                            and videography agency focused on theatre and live performance.
                        </p>
                        <p>
                            The team at Neon 8 includes an Adobe Certified
                            Expert who is experienced in filmmaking, VR films,
                            and software training not only in the UK, but across
                            Europe as well.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================
             APP SHOWCASE
             ======================================== -->
        <section class="bovr-app" data-theme="dark">
            <div class="bovr-app__image">
                <img
                    src="/images/work/bovr/image-bovr-app.png"
                    alt="Box Office VR App Screens"
                />
            </div>
        </section>

        <!-- ========================================
             ARTICLE SECTION 1
             ======================================== -->
        <section class="bovr-article" data-theme="dark">
            <div class="section-inner bovr-article__inner">
                <div class="bovr-article__text">
                    <p>
                        To further enhance the <span class="bold"
                            >user experience</span
                        >, we also developed a <span class="bold"
                            >user interface system</span
                        > in VR that makes navigation <span class="bold"
                            >easier</span
                        > and <span class="bold">more intuitive</span>, making
                        the overall experience <span class="bold">smoother</span
                        > and <span class="bold">more enjoyable</span>.
                    </p>
                    <p>
                        Our development of a <span class="bold"
                            >web-based VR player</span
                        >, <span class="bold">mobile-based VR version</span>,
                        and <span class="bold"
                            >different video quality options</span
                        > has made it possible to turn live theatre into a <span
                            class="bold">VR streaming service</span
                        >. This benefits <span class="bold">actors</span> and those
                        who work in the industry by providing them with <span
                            class="bold">new possibilities</span
                        > for <span class="bold">content creation</span>, <span
                            class="bold">performance</span
                        >, and <span class="bold">consumption</span>
                    </p>
                </div>
                <div class="bovr-article__image">
                    <img
                        src="/images/work/bovr/image-bovr-article1.png"
                        alt="Box Office VR Article"
                    />
                </div>
            </div>
        </section>

        <!-- ========================================
             YOUTUBE 1
             ======================================== -->
        <section class="bovr-youtube" data-theme="dark">
            <div class="section-inner">
                <div class="bovr-youtube__video">
                    <iframe
                        src="https://www.youtube.com/embed/qgkdrGsE6vs?si=isK_CfAV0iUajSox"
                        title="Box Office VR YouTube"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen></iframe>
                </div>
            </div>
        </section>

        <!-- ========================================
             ARTICLE SECTION 2
             ======================================== -->
        <section class="bovr-article bovr-article--alt" data-theme="dark">
            <div
                class="section-inner bovr-article__inner bovr-article__inner--alt"
            >
                <div class="bovr-article__image">
                    <img
                        src="/images/work/bovr/image-bovr-article2.png"
                        alt="Box Office VR Article 2"
                    />
                </div>
                <div class="bovr-article__text">
                    <p>
                        The use of <span class="bold"
                            >virtual reality technology</span
                        > in <span class="bold">live theatre</span>
                        has the potential to <span class="bold"
                            >revolutionise</span
                        > the <span class="bold">entertainment industry</span>.
                        Our development of a <span class="bold"
                            >web-based VR player</span
                        > and
                        <span class="bold">mobile-based VR version</span>, along
                        with the <span class="bold"
                            >different video quality options</span
                        > and <span class="bold">user interface system</span>,
                        are
                        <span class="bold">significant steps</span> towards achieving
                        this goal. With further advancements in technology, we can
                        expect to see even more <span class="bold"
                            >exciting developments</span
                        > in the <span class="bold">entertainment industry</span
                        > in the future.
                    </p>
                </div>
            </div>
        </section>

        <!-- ========================================
             YOUTUBE 2
             ======================================== -->
        <section class="bovr-youtube" data-theme="dark">
            <div class="section-inner">
                <div class="bovr-youtube__video">
                    <iframe
                        src="https://www.youtube.com/embed/ZIqerDAYQF4?si=AzsEb7bnZzQADBuX"
                        title="Box Office VR YouTube 2"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen></iframe>
                </div>
            </div>
        </section>

        <!-- ========================================
             VR IMAGE
             ======================================== -->
        <section class="bovr-vr" data-theme="dark">
            <div class="bovr-vr__image">
                <img
                    src="/images/work/bovr/image-bovr-VR.png"
                    alt="Box Office VR Headset"
                />
            </div>
        </section>
    </main>

    <OtherWork currentSlug="the-magic-of-theatre-at-home" />

    <Footer />
</BaseLayout>
