---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import OtherWork from "../../components/OtherWork.astro";
---

<BaseLayout
    title="Bringing Art To Life – VIVID Sydney 2019 | 42 Interactive"
    bodyClass="vivid-page"
    additionalStyles={["/css/amica.css", "/css/vivid.css"]}
>
    <Header activePage="home" />

    <main class="main-content">
        <!-- ========================================
             HERO
             ======================================== -->
        <section class="vivid-hero section-hero fade-in" data-theme="dark">
            <div class="hero-bg-mask">
                <img
                    src="/images/work/vivid/image-vivid-hero.png"
                    alt="VIVID Sydney 2019 installation"
                    class="hero-bg-image"
                />
            </div>
            <div class="hero-info">
                <div class="hero-text-box">
                    <h1 class="hero-title">Bringing Art<br />To Life</h1>
                </div>
            </div>
        </section>

        <!-- ========================================
             INTRO – WHAT WE'VE DONE
             ======================================== -->
        <section class="vivid-intro section-intro fade-in" data-theme="dark">
            <p class="intro-label">WHAT WE'VE DONE</p>
            <p class="intro-text">
                We <span class="bold">designed</span> and <span class="bold"
                    >developed</span
                > an <span class="bold">interactive artwork</span> that came alive
                through <span class="bold">audience participation</span>.<br />
                Using <span class="bold">face and body tracking</span>, the
                experience <span class="bold">responded uniquely</span> to each visitor.<br
                />
                It <span class="bold">transformed</span> passive viewing into an <span
                    class="bold">inclusive, shared moment</span
                >.
            </p>
        </section>

        <!-- ========================================
             YOUTUBE VIDEO SECTION
             ======================================== -->
        <section class="vivid-youtube-section fade-in" data-theme="dark">
            <div class="video-container">
                <iframe
                    src="https://www.youtube.com/embed/HeJnddDG4YI"
                    title="See What I See - Vivid 2019"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                >
                </iframe>
            </div>
        </section>

        <!-- ========================================
             INCLUSIVE CREATIVE + ARTIST SECTION
             ======================================== -->
        <section class="vivid-artist-section fade-in" data-theme="dark">
            <div class="vivid-artist-section__container">
                <h2 class="section-title">Inclusive Creative Technology</h2>
                <p class="section-label">THE ARTIST WE COLLABORATE WITH</p>
                <div class="section-divider"></div>
                <div class="artist-content">
                    <div class="artist-text">
                        <p>
                            "<span class="bold">See What I See</span>" is an <span
                                class="bold">interactive installation</span
                            > that invites visitors to experience how they are seen
                            through <span class="bold">Digby's eyes</span>.
                            Standing in front of the frame, audiences see their
                            features and expressions interpreted through <span
                                class="bold">advanced facial recognition</span
                            >, transforming them into a <span class="bold"
                                >shifting vision of colour and light</span
                            >
                            rendered in Digby's <span class="bold"
                                >distinctive style</span
                            >.
                        </p>
                        <p>
                            Digby is a <span class="bold">widely exhibited</span
                            >, <span class="bold"
                                >Sydney-based visual artist</span
                            > whose work spans <span class="bold"
                                >abstracts</span
                            >, <span class="bold">portraits</span>, and <span
                                class="bold">landscapes</span
                            >. His canvases burst with <span class="bold"
                                >vibrant colour</span
                            >, shaped by a <span class="bold">unique</span> and <span
                                class="bold">deeply personal way of seeing</span
                            >
                            the world — a perspective that sits at the <span
                                class="bold">heart of the experience</span
                            >.
                        </p>
                    </div>
                    <div class="artist-info">
                        <img
                            src="/images/work/vivid/image-vivid-digby.png"
                            alt="Digby Webster"
                            class="artist-image"
                        />
                        <p class="artist-name">Digby Webster</p>
                        <p class="artist-title">Visual Artist</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================
             TECHNOLOGY SECTION
             ======================================== -->
        <section class="vivid-tech-section fade-in" data-theme="light">
            <div class="vivid-tech-section__container">
                <div class="tech-columns">
                    <div class="tech-column">
                        <p>
                            The experience was designed to feel <span
                                class="bold">intimate</span
                            > and <span class="bold">exclusive</span>, while
                            remaining completely <span class="bold"
                                >frictionless</span
                            >. <span class="bold">Face and body tracking</span> allowed
                            visitors to engage
                            <span class="bold">naturally</span>, ensuring the
                            work could be enjoyed by
                            <span class="bold">everyone</span>
                            <span class="bold">without barriers</span>.
                        </p>
                    </div>
                    <div class="tech-column">
                        <p>
                            Participants simply <span class="bold"
                                >step into the space</span
                            > and are
                            <span class="bold">instantly immersed</span>, with <span
                                class="bold">no instructions or devices</span
                            >
                            required. This approach <span class="bold"
                                >maximised participation</span
                            >
                            while preserving a sense of <span class="bold"
                                >considered</span
                            >,
                            <span class="bold">gallery-quality engagement</span
                            >.
                        </p>
                    </div>
                    <div class="tech-column">
                        <p>
                            At the core of the installation, a <span
                                class="bold">Microsoft Kinect V2.0</span
                            >
                            powers the <span class="bold">face tracking</span> that
                            drives Digby's artwork. His <span class="bold"
                                >hand-drawn illustrations</span
                            > were <span class="bold"
                                >scanned and separated</span
                            > into facial elements, then <span class="bold"
                                >recombined</span
                            >
                            in <span class="bold">real time</span> to generate <span
                                class="bold">unique faces</span
                            >. Paired with
                            <span class="bold">varied backgrounds</span>, each
                            interaction produces a
                            <span class="bold"
                                >one-of-a-kind digital portrait</span
                            >, resulting in <span class="bold"
                                >endless visual outcomes</span
                            > for every visitor.
                        </p>
                    </div>
                </div>
                <div class="tech-images">
                    <img
                        src="/images/work/vivid/image-vivid-diagram.png"
                        alt="Technical diagram"
                        class="tech-diagram"
                    />
                    <img
                        src="/images/work/vivid/image-vivid-face.png"
                        alt="Face tracking visualization"
                        class="tech-face"
                    />
                </div>
            </div>
        </section>

        <!-- ========================================
             GALLERY IMAGE SECTION
             ======================================== -->
        <section class="vivid-gallery-section fade-in" data-theme="dark">
            <img
                src="/images/work/vivid/image-vivid-gallery.png"
                alt="VIVID installation in gallery"
            />
        </section>
    </main>

    <OtherWork currentSlug="bringing-art-to-life" />

    <Footer />
</BaseLayout>
