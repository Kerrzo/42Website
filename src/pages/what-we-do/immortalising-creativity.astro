---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import OtherWork from "../../components/OtherWork.astro";
---

<BaseLayout
    title="White Rabbit Gallery – Immortalising Creativity | 42 Interactive"
    bodyClass="wrg-page"
    additionalStyles={["/css/amica.css", "/css/wrg.css"]}
>
    <Header activePage="home" />

    <main class="main-content">
        <!-- ========================================
             HERO
             ======================================== -->
        <section class="wrg-hero section-hero fade-in" data-theme="dark">
            <img
                src="/images/work/wrg/42i/image-wrg-hero.png"
                alt="White Rabbit Gallery interior"
                class="hero-bg-image"
            />
            <div class="hero-info">
                <div class="hero-text-box">
                    <h1 class="hero-title">Immortalising<br />Creativity</h1>
                </div>
            </div>
        </section>

        <!-- ========================================
             INTRO – WHAT WE'VE DONE
             ======================================== -->
        <section class="wrg-intro section-intro fade-in" data-theme="dark">
            <p class="intro-label">WHAT WE'VE DONE</p>
            <p class="intro-text">
                We created a precise <span class="bold">digital twin</span> of White
                Rabbit Gallery's private Chinese art collection, making it <span
                    class="bold">accessible beyond the physical space</span
                >.
            </p>
        </section>

        <!-- ========================================
             3D SECTION
             ======================================== -->
        <section class="wrg-3d-section fade-in" data-theme="dark">
            <p class="wrg-description">
                <a href="https://whiterabbitcollection.org/"
                    ><span class="bold">The White Rabbit art gallery</span></a
                > is a <span class="bold">premier destination</span> for anyone interested
                in <span class="bold"
                    >21st-century Chinese contemporary art</span
                >. With <span class="bold">over 3000 works</span> by <span
                    class="bold">700 different artists</span
                >, the collection offers something for everyone. The gallery was
                founded by <span class="bold">Judith Neilson</span>, who was
                inspired to establish it after her <span class="bold"
                    >first trips to Beijing</span
                > in the <span class="bold">late 1990s</span>. She was thrilled
                by the idea of a society that is so <span class="bold"
                    >different</span
                > from what she had seen in
                <span class="bold">Australia</span>.
            </p>
            <div class="wrg-3d-image">
                <iframe
                    id="wrg-matterport"
                    src="https://my.matterport.com/show/?m=3H7iw9mArek&play=0"
                    data-autoplay-src="https://my.matterport.com/show/?m=3H7iw9mArek&play=1"
                    frameborder="0"
                    allowfullscreen
                    loading="lazy"
                    allow="autoplay; fullscreen; web-share; xr-spatial-tracking;"
                    style="width: 100%; height: 100%; border: 0;"></iframe>
            </div>
        </section>

        <!-- ========================================
             GALLERY 1 WITH STATEMENT
             ======================================== -->
        <section class="wrg-gallery1 fade-in" data-theme="dark">
            <img
                src="/images/work/wrg/42i/image-wrg-gallery1.png"
                alt="White Rabbit Gallery exhibition space"
            />
            <h2 class="gallery1-statement">
                Making the world's most significant Chinese Contemporary Art
                accessible for everyone.
            </h2>
        </section>

        <!-- ========================================
             GALLERY 2
             ======================================== -->
        <section class="wrg-gallery2 fade-in" data-theme="dark">
            <img
                src="/images/work/wrg/42i/image-wrg-galllery2.png"
                alt="White Rabbit Gallery artwork display"
            />
            <div class="gallery2-text">
                <h3>We leverage 3D scanning technology to preserve art.</h3>
            </div>
        </section>
    </main>

    <OtherWork currentSlug="immortalising-creativity" />

    <Footer />
</BaseLayout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const iframe = document.getElementById(
            "wrg-matterport",
        ) as HTMLIFrameElement | null;
        if (!iframe) return;

        const autoplaySrc = iframe.getAttribute("data-autoplay-src");
        if (!autoplaySrc) return;

        let hasPlayed = false;
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting && !hasPlayed) {
                        iframe.src = autoplaySrc;
                        hasPlayed = true;
                        observer.disconnect();
                    }
                });
            },
            {
                threshold: 0.4,
            },
        );

        observer.observe(iframe);
    });
</script>
