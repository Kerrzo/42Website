---
import configData from "../data/config.json";

interface Props {
    title: string;
    description?: string;
    additionalStyles?: string[];
    bodyClass?: string;
    /** Absolute or root-relative image used for link previews (og:image). */
    ogImage?: string;
    /** Open Graph type: "website" (default) or "article" for blog posts. */
    ogType?: "website" | "article";
    /** ISO date, only used with ogType="article". */
    publishedTime?: string;
    /** Keep the page out of search indexes (also drops the canonical tag). */
    noindex?: boolean;
    /** schema.org JSON-LD object(s); see src/data/schema.ts. */
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const DEFAULT_OG_IMAGE = "/images/og-default.jpg";

const {
    title,
    description = "42 Interactive - Building What Others Only Imagine",
    additionalStyles = [],
    bodyClass = "",
    ogImage,
    ogType = "website",
    publishedTime,
    noindex = false,
    jsonLd,
} = Astro.props;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Canonical URL: absolute, always with the trailing slash GitHub Pages serves
const site = Astro.site ?? new URL("https://42interactive.com");
let canonicalPath = Astro.url.pathname;
if (!canonicalPath.endsWith("/") && !/\.[a-z0-9]+$/i.test(canonicalPath)) {
    canonicalPath += "/";
}
const canonicalUrl = new URL(canonicalPath, site).href;
const ogImageUrl = new URL(ogImage ?? DEFAULT_OG_IMAGE, site).href;
const usingDefaultOgImage = !ogImage;

// Get base URL from Astro config
// BASE_URL is automatically set by Astro based on the base config
const baseUrl = (import.meta.env as any).BASE_URL || "/";

// Get Google Analytics ID from config
const gaId = (configData as any).googleAnalytics;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex ? (
            <meta name="robots" content="noindex, follow" />
        ) : (
            <link rel="canonical" href={canonicalUrl} />
        )}

        <!-- Open Graph / link previews -->
        <meta property="og:site_name" content="42 Interactive" />
        <meta property="og:locale" content="en_AU" />
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />
        {usingDefaultOgImage && (
            <>
                <meta property="og:image:width" content="1200" />
                <meta property="og:image:height" content="630" />
            </>
        )}
        {ogType === "article" && publishedTime && (
            <meta property="article:published_time" content={publishedTime} />
        )}
        {
            jsonLdBlocks.map((block) => (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(block).replace(/</g, "\\u003c")}
                />
            ))
        }
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />

        <link rel="icon" type="image/jpeg" href={`${baseUrl}images/42logoWhite.jpg`} />
        <link rel="stylesheet" href={`${baseUrl}css/styles.css`} />
        {
            additionalStyles.map((style) => (
                <link
                    rel="stylesheet"
                    href={
                        style.startsWith("/")
                            ? `${baseUrl}${style.slice(1)}`
                            : style
                    }
                />
            ))
        }
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500&family=Barlow+Condensed:wght@400&display=swap"
            rel="stylesheet"
        />
        {
            gaId && (
                <>
                    <script
                        async
                        src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
                    />
                    <script
                        is:inline
                        define:vars={{ gaId }}
                    >
                        window.dataLayer = window.dataLayer || [];
                        function gtag(){dataLayer.push(arguments);}
                        gtag('js', new Date());
                        gtag('config', gaId);
                    </script>
                </>
            )
        }
    </head>
    <body class={bodyClass}>
        <slot />

        <!-- YouTube Lightbox -->
        <div id="youtube-lightbox" class="youtube-lightbox">
            <div class="lightbox-backdrop"></div>
            <div class="lightbox-content">
                <button class="lightbox-close">&times;</button>
                <iframe
                    id="youtube-player"
                    src=""
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
            </div>
        </div>

        <!-- JavaScript -->
        <script is:inline src={`${baseUrl}js/header.js`}></script>
        <script is:inline src={`${baseUrl}js/buttons.js`}></script>
        <script is:inline src={`${baseUrl}js/animations.js`}></script>
        <script is:inline src={`${baseUrl}js/youtube.js`}></script>
        <script is:inline src={`${baseUrl}js/podcasts.js`}></script>
        <script is:inline src={`${baseUrl}js/clients.js`}></script>
        <script is:inline src={`${baseUrl}js/testimonials.js`}></script>
        <script is:inline src={`${baseUrl}js/gradient.js`}></script>
        <script is:inline src={`${baseUrl}js/main.js`}></script>
        <script is:inline src={`${baseUrl}js/stars-background.js`}></script>
    </body>
</html>
