---
interface Props {
    activePage?: "home" | "who-we-are" | "what-we-do" | "ai" | "services";
}

const { activePage = "home" } = Astro.props;
// trailing-slash path of this page, to highlight the open case study in the mobile menu
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const on = (page: string) => (activePage === page ? " active" : "");
---

<header class="main-menu header-theme-dark">
    <div class="header-container">
        <a href="/" class="logo-container">
            <img
                src="/images/logo-42interactive-h.svg"
                alt="42 Interactive"
                class="logo-42i"
            />
        </a>
        <nav class="nav-menu">
            <a
                href="/services/"
                class={`nav-link ${activePage === "services" ? "active" : ""}`}
                >Services</a
            >
            <a
                href="/ai/"
                class={`nav-link ${activePage === "ai" ? "active" : ""}`}
                >AI</a
            >
            <a
                href="/what-we-do/"
                class={`nav-link ${activePage === "what-we-do" ? "active" : ""}`}
                >Work</a
            >
            <a
                href="/who-we-are/"
                class={`nav-link ${activePage === "who-we-are" ? "active" : ""}`}
                >About</a
            >
            <button class="btn-get-touch">Let's Talk</button>
            <button class="mobile-menu-toggle" aria-label="Toggle mobile menu">
                <span class="hamburger-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
                <span class="close-icon">&times;</span>
            </button>
        </nav>
    </div>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu-overlay"></div>
<nav class="mobile-menu">
    <a href="/services/" class={`mobile-nav-link${on("services")}`}>Services</a>
    <a href="/ai/" class={`mobile-nav-link${on("ai")}`}>AI</a>
    <div class="mobile-nav-item-with-submenu">
        <a href="/what-we-do/" class={`mobile-nav-link${on("what-we-do")}`}>Work</a>
        <div class="mobile-submenu">
            <a href="/what-we-do/building-restaurants-of-the-future/" class={`mobile-submenu-link${path === "/what-we-do/building-restaurants-of-the-future/" ? " active" : ""}`}><span class="submenu-chevron">›</span>Building Restaurants of The Future</a>
            <a href="/what-we-do/a-brand-that-feels-like-a-friend/" class={`mobile-submenu-link${path === "/what-we-do/a-brand-that-feels-like-a-friend/" ? " active" : ""}`}><span class="submenu-chevron">›</span>A Brand That Feels Like a Friend</a>
            <a href="/what-we-do/connecting-people-to-workplace/" class={`mobile-submenu-link${path === "/what-we-do/connecting-people-to-workplace/" ? " active" : ""}`}><span class="submenu-chevron">›</span>Connecting People to workplace</a>
            <a href="/what-we-do/putting-the-intelligence-in-ai/" class={`mobile-submenu-link${path === "/what-we-do/putting-the-intelligence-in-ai/" ? " active" : ""}`}><span class="submenu-chevron">›</span>Putting the Intelligence in AI</a>
            <a href="/what-we-do/the-magic-of-theatre-at-home/" class={`mobile-submenu-link${path === "/what-we-do/the-magic-of-theatre-at-home/" ? " active" : ""}`}><span class="submenu-chevron">›</span>The Magic of Theatre at home</a>
            <a href="/what-we-do/a-better-way-to-manage-pain/" class={`mobile-submenu-link${path === "/what-we-do/a-better-way-to-manage-pain/" ? " active" : ""}`}><span class="submenu-chevron">›</span>A Better Way to Manage Pain</a>
            <a href="/what-we-do/immortalising-creativity/" class={`mobile-submenu-link${path === "/what-we-do/immortalising-creativity/" ? " active" : ""}`}><span class="submenu-chevron">›</span>Immortalising Creativity</a>
            <a href="/what-we-do/putting-smiles-on-peoples-faces/" class={`mobile-submenu-link${path === "/what-we-do/putting-smiles-on-peoples-faces/" ? " active" : ""}`}><span class="submenu-chevron">›</span>Putting Smiles on Peoples Faces</a>
            <a href="/what-we-do/bringing-products-to-life/" class={`mobile-submenu-link${path === "/what-we-do/bringing-products-to-life/" ? " active" : ""}`}><span class="submenu-chevron">›</span>Bringing Products to Life</a>
        </div>
    </div>
    <a href="/who-we-are/" class={`mobile-nav-link${on("who-we-are")}`}>About</a>
    <button class="btn-get-touch mobile-menu-cta">Let's Talk</button>
</nav>
